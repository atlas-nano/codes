# ─── Example LAMMPS input: on-the-fly 2PT for liquid Argon (real units) ──────
#
# System : 500 Ar atoms, T = 100 K, rho ~ 1.40 g/cm3  (liquid state)
# Force field: LJ/cut with standard Ar parameters
#   epsilon/kB = 119.8 K  ->  epsilon = 0.2379 kcal/mol
#   sigma      = 3.405 Ang
#   cutoff     = 2.5 * sigma = 8.5125 Ang
#
# This example uses units real so that 2PT produces FULL quantum thermodynamics:
#   f_2pt[1]  S_q   [J/(mol*K)]  quantum entropy
#   f_2pt[2]  A_q   [kJ/mol]     quantum Helmholtz free energy
#   f_2pt[3]  E_q   [kJ/mol]     quantum internal energy
#   f_2pt[4]  Cv_q  [J/(mol*K)]  quantum isochoric heat capacity
#   f_2pt[5]  D     [cm^2/s]     self-diffusivity
#   f_2pt[6]  f                  fluidicity (gas fraction, dimensionless)
#   f_2pt[7]  T_vac [K]          temperature derived from VAC at lag 0
#   f_2pt[8]  ZPE_q [kJ/mol]     quantum zero-point energy (solid component)
#
# Mapping to LJ reduced units (for cross-check with in.2pt_argon_lj):
#   T*   = T / (eps/kB)  = 100 / 119.8  ~ 0.835
#   rho* = rho * sigma^3 / m  (number density * sigma^3)
#            = (1.40 g/cm3 / 39.948 g/mol * 6.022e23) * (3.405e-8 cm)^3
#            ~ 0.836
#   D*   = D * sqrt(m / (eps * sigma^2))  (see Lin 2003 Eq. 31 for unit conversion)
# ─────────────────────────────────────────────────────────────────────────────

units           real
atom_style      atomic
boundary        p p p

# ── Build liquid-density Ar box ───────────────────────────────────────────────
# rho = 1.40 g/cm3, N = 500:
#   V = N*m / (rho*Na) = 500 * 39.948 / (1.40 * 6.022e23) = 2.369e-20 cm3
#   V = 2.369e-20 cm3 * 1e24 Ang3/cm3 = 23690 Ang3
#   L = V^(1/3) = 28.73 Ang
variable        N    equal 500
variable        Lbox equal 28.73    # Ang  (rho* ~ 0.836)

region          simbox block 0 ${Lbox} 0 ${Lbox} 0 ${Lbox} units box
create_box      1 simbox
create_atoms    1 random ${N} 98765 simbox

# ── Force field ───────────────────────────────────────────────────────────────
mass            1 39.948                         # g/mol (Ar)
pair_style      lj/cut 8.5125                    # rc = 2.5 * sigma
pair_coeff      1 1 0.2379 3.405 8.5125          # eps [kcal/mol], sigma [Ang], rc [Ang]

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ── Remove overlaps from random placement ─────────────────────────────────────
minimize        1.0e-6 1.0e-8 10000 100000

# ── Time step and initial velocities ──────────────────────────────────────────
timestep        1.0    # 1 fs (standard for real-unit Ar simulations)
velocity        all create 100.0 54321 dist gaussian

# ── Equilibration: NPT ────────────────────────────────────────────────────────
fix             eq_npt all npt temp 100.0 100.0 100.0 iso 1.0 1.0 1000.0

thermo_style    custom step temp press vol density etotal
thermo          1000

run             100000    # 100 ps equilibration

# ── Switch to NVT for 2PT production ──────────────────────────────────────────
unfix           eq_npt
fix             prod_nvt all nvt temp 100.0 100.0 100.0

fix             2pt all xpt 5 512 ar_real classical normalize

# ── Thermo output ─────────────────────────────────────────────────────────────
# Quantum:   f_2pt[1]=S_q  [2]=A_q  [3]=E_q  [4]=Cv_q  [5]=D  [6]=f  [7]=T_vac  [8]=ZPE_q
thermo_style    custom step etotal temp press density &
                f_2pt[1] f_2pt[2] f_2pt[3] f_2pt[4] f_2pt[5] f_2pt[6] f_2pt[7] f_2pt[8]
thermo          2560     # every completed 2PT window (512 * 5 = 2560 steps)
dump                 1 all custom 5 ar.2pt.lammps id type xu yu zu vx vy vz
# ── Production: 20 full 2PT windows ──────────────────────────────────────────
run             51200    # 20 windows * 2560 steps = 51.2 ps
