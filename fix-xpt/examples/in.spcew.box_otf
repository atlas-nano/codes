units                real
atom_style           full
boundary             p p p
dielectric           1
special_bonds        lj/coul 0.0 0.0 1.0
                     
pair_style           lj/charmm/coul/long 9 10.00000
bond_style           harmonic
angle_style          harmonic
dihedral_style       none
improper_style       none
kspace_style         pppm 1e-05
                     
read_data            data.spcew.box
                     
pair_modify          mix geometric
neighbor             2.0 multi
neigh_modify         every 2 delay 4 check yes
thermo_style         multi
thermo_modify        line multi format float %14.6f flush yes
variable             sname string spcew.box
variable             rtemp index 298                     
                     
timestep             1
                     
                     
                     
fix                  shakeH all shake 0.0001 20 500 m 1.008 a 1
print                .
print                ==========================================
print                "500 steps CG Minimization"
print                ==========================================
print                .
                     
dump                 1 all custom 25 ${sname}.min.lammps id type xu yu zu vx vy vz
thermo               10
min_style            sd
minimize             1.0e-4 1.0e-4 500 5000
min_style            cg
minimize             1.0e-4 1.0e-4 500 5000
#now                 minimize the entire system
minimize             1.0e-4 1.0e-4 500 5000
undump               1
                     
thermo               100
print                .
print                ================================================
print                "NVT production dynamics "
print                ================================================
print                .
                     
velocity             all create ${rtemp} 123981231 dist gaussian
fix                  2 all nvt temp ${rtemp} ${rtemp} 100.0 tloop 10 ploop 10
dump                 1 all custom 1000 ${sname}.${rtemp}K.prod.lammps id type xu yu zu vx vy vz
run                  10000 # 10000 steps x 1 fs = 10 ps
unfix                2

print                "================================================"
print                "NVT dynamics for 100ps (10 x 10ps windows) calculating thermo using fix xpt"
print                "================================================"
fix                  1 all nvt temp ${rtemp} ${rtemp} 100.0
fix                  2pt all xpt 2 5000 spcew.box.${rtemp}K.otf_full classical normalize molecule symmetry C2v mode 2PT
thermo_style         custom etotal ke temp pe ebond eangle edihed eimp evdwl ecoul elong press vol f_2pt[1] f_2pt[2] f_2pt[3] f_2pt[4] f_2pt[5] f_2pt[6] f_2pt[7] f_2pt[12]
thermo_modify        line multi
run                  100000
unfix                2pt
undump               1
