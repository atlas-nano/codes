#example of calculating the thermodynamics of a dynamic group with specified density
units                real
atom_style           full
boundary             p p p
dielectric           1
special_bonds        lj/coul 0.0 0.0 0.5
                     
pair_style           lj/charmm/coul/long 9 10
bond_style           harmonic
angle_style          harmonic
dihedral_style       nharmonic
improper_style       cvff
kspace_style         pppm 1e-05
                     
read_data            data.dynamic_groups
                     
pair_modify          mix geometric
neighbor             2.0 multi
neigh_modify         every 2 delay 4 check yes
thermo_style         multi
thermo_modify        line multi format float %14.6f flush yes
variable             sname string dyn_grp
group                tmp0 id <> 2692 2703
group                solute union tmp0
                     
group                solvent subtract all solute
                     
variable             rtemp index 298

timestep             1
                     
fix                  shakeH all shake 0.0001 20 500 m 1.008 a 1
print                .
print                ==========================================
print                "500 steps CG Minimization"
print                ==========================================
print                .
                     
dump                 1 all custom 25 ${sname}.min.lammps id type xu yu zu vx vy vz
thermo               10
fix                  restraint solute spring/self 500.0
min_style            sd
minimize             1.0e-4 1.0e-4 500 5000
min_style            cg
minimize             1.0e-4 1.0e-4 500 5000
#now                 minimize the entire system
unfix                restraint
minimize             1.0e-4 1.0e-4 500 5000
undump               1
                     
                     
print                .
print                =====================================
print                "NVT dynamics to heat system"
print                =====================================
print                .
                     
thermo               100
dump                 1 all custom 1000 ${sname}.heat.lammpstrj id type xu yu zu vx vy vz
fix                  3 all nvt temp 1.0 ${rtemp} 100.0
run                  1000
unfix                3
fix                  3 all nvt temp ${rtemp} ${rtemp} 100.0
run                  9000
unfix                3
undump               1
                     
print                .
print                ================================================
print                "NPT dynamics with an isotropic pressure of 1atm."
print                ================================================
print                .
                     
fix                  2 all npt temp ${rtemp} ${rtemp} 100.0 iso 1.0 1.0 2000.0
dump                 1 all custom 5000 ${sname}.${rtemp}K.npt.lammps id type xu yu zu vx vy vz
run                  10000
undump               1
unfix                2
                     
print                .
print                ================================================
print                "NVT production dynamics "
print                ================================================
print                .
                     
fix                  2 all nvt temp ${rtemp} ${rtemp} 100.0 tloop 10 ploop 10
dump                 1 all custom 1000 ${sname}.${rtemp}K.prod.lammps id type xu yu zu vx vy vz
run                  10000 
unfix                2
undump               1

write_restart        ${sname}.${rtemp}K.restart
#label                twoPT
#fix                  shakeH all shake 0.0001 20 500 m 1.008 a 1

#now we determine the number of water molecules in the 1st solvation shell (within 3.5 angstroms of the solute)
variable             dens index 0.9995 #water density 0.995 g/cm3	
group                shell1 dynamic solute within 3.5 include molecule every 10000 exclude solute
variable             n equal count(shell1)
variable             m equal mass(shell1)
variable             s1 equal mass(shell1)/0.6023/${dens} #volume of shell1 solvents
run                  0 post no
print                "SOLVATION SHELL1 INIT:: natom: ${n} mass: ${m} volume: ${s1}"

print                "================================================"
print                "NVT dynamics for 20ps dumping velocities"
print                "================================================"
thermo               1000
reset_timestep       0 #allows for syncing
thermo_style         custom etotal ke temp pe ebond eangle edihed eimp evdwl ecoul elong press vol
thermo_modify        line multi
fix                  2pt_u solute xpt 2 5000 ${sname}.${rtemp}K.solute classical normalize mode 2PT molecule
fix                  solu_thermo solute ave/time 10000 10 100000 f_2pt_u[*] file ${sname}.${rtemp}K.solu.thermo_avg.dat
fix                  2pt_v solvent xpt 2 5000 ${sname}.${rtemp}K.solvent classical normalize mode 2PT molecule symmetry C2v
fix                  solv_thermo solvent ave/time 10000 10 100000 f_2pt_v[*] file ${sname}.${rtemp}K.solv.thermo_avg.dat
fix                  2pt_s1 shell1 xpt 2 5000 ${sname}.${rtemp}K.solv_shell1 classical normalize mode 2PT molecule symmetry C2v volume v_s1
fix                  s1_thermo shell1 ave/time 10000 10 100000 f_2pt_s1[*] file ${sname}.${rtemp}K.shell1.thermo_avg.dat
fix                  1 all nvt temp ${rtemp} ${rtemp} 100.0
# No `run 0` here: a zero-step run completes no analysis window, which the
# FFT correlator rejects.  Go straight to the production run.
run                  100000
unfix                1
