units                real
atom_style           full
boundary             p p p
dielectric           1
special_bonds        lj/coul 0.0 0.0 0.8
                     
pair_style           lj/charmm/coul/long 7 8
bond_style           harmonic
angle_style          harmonic
dihedral_style       fourier
improper_style       cvff
kspace_style         pppm 1e-05
                     
read_data            data.benzene

pair_modify          mix arithmetic
neighbor             2.0 multi
neigh_modify         every 2 delay 4 check yes
thermo_style         multi
thermo_modify        line multi format float %14.6f flush yes
variable             sname string benzene.box
variable             rtemp index 298                     
                     
timestep             1
                     
fix                  shakeH all shake 0.0001 20 500 m 1.008
print                .
print                ==========================================
print                "500 steps CG Minimization"
print                ==========================================
print                .
                     
dump                 1 all custom 25 ${sname}.min.lammps id type xu yu zu vx vy vz
thermo               10
min_style            sd
minimize             1.0e-4 1.0e-4 500 5000
min_style            cg
minimize             1.0e-4 1.0e-4 500 5000
#now                 minimize the entire system
minimize             1.0e-4 1.0e-4 500 5000
undump               1
                     
                     
print                .
print                =====================================
print                "NVT dynamics to heat system"
print                =====================================
print                .
                     
thermo               100
dump                 1 all custom 1000 ${sname}.heat.lammpstrj id type xu yu zu vx vy vz
fix                  3 all nvt temp 1.0 ${rtemp} 100.0
run                  1000
unfix                3
fix                  3 all nvt temp ${rtemp} ${rtemp} 100.0
run                  9000
unfix                3
undump               1
                     
print                .
print                ================================================
print                "NPT dynamics with an isotropic pressure of 1atm."
print                ================================================
print                .
                     
fix                  2 all npt temp ${rtemp} ${rtemp} 100.0 iso 1.0 1.0 2000.0
dump                 1 all custom 5000 ${sname}.${rtemp}K.npt.lammps id type xu yu zu vx vy vz
run                  10000 # run for 15 ns
undump               1
unfix                2
                     
print                .
print                ================================================
print                "NVT production dynamics "
print                ================================================
print                .
                     
fix                  2 all nvt temp ${rtemp} ${rtemp} 100.0 tloop 10 ploop 10
dump                 1 all custom 1000 ${sname}.${rtemp}K.prod.lammps id type xu yu zu vx vy vz
run                  10000 # run for 15 ns
unfix                2
undump               1

write_restart        ${sname}.${rtemp}K.restart

label                twoPT
reset_timestep       0
log                  ${sname}.${rtemp}K.2pt.eng
run                  0 post no
# Define the fix after the zero-step initialisation: a `run 0` completes no
# analysis window, and the FFT correlator rejects a run shorter than one.
fix                  2pt all xpt 2 5000 ${sname}.${rtemp}K classical normalize mode 2PT molecule symmetry D6h
print "================================================"
print "NVT dynamics for 20ps dumping velocities"
print "================================================"
thermo          2
thermo_style    custom etotal ke temp pe ebond eangle edihed eimp evdwl ecoul elong press vol
thermo_modify	line multi
fix             1 all nvt temp ${rtemp} ${rtemp} 100.0
dump            1 all custom 2 ${sname}.${rtemp}K.2pt.lammps id type xu yu zu vx vy vz 
run             10000
undump          1
unfix           1
