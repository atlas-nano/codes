# Entropy (2PT/3PT) at the chosen LJ sigma=3.144, from the NPT-equilibrated restart.
# Fresh NVE + fix xpt from the restart.
# S_q = .thermo column 2 (eV/K/molecule) * 96485 = J/mol/K.  Target band 63-65 J/mol/K.
read_restart spcfq_s3144.restart
group fq type 1 2
pair_style hybrid/overlay lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 all
pair_coeff 1 1 lj/cut 0.01275 3.144
pair_coeff 1 2 lj/cut 0.0 1.0
pair_coeff 2 2 lj/cut 0.0 1.0
pair_coeff * * coul/long
pair_coeff * * coul/shield/intra 1.11
kspace_style pppm/samqeq 1.0e-6
neighbor 2.0 bin
timestep 0.001
fix chg fq qeq/sam 1 0.0 10.0 1.0e-5 spcfq_expt.param
group oxy type 1
compute msdO oxy msd com yes
fix integ all rigid/nve/small molecule
fix MOM all momentum 10 linear 1 1 1
variable COMMON string "classical normalize molecule symmetry C2v show_split gas_gate debye"
variable CAGE string "cage_nf_run 3 cage_taper hann cage_tail_tol 0.2 cage_ref markov"
fix X1 fq xpt 4 2048 s3144.2pt.rig  ${COMMON} mode 2PT refinement rigorous
fix X4 fq xpt 4 2048 s3144.2pt.r2pt ${COMMON} mode 2PT refinement r2pt
fix X5 fq xpt 4 2048 s3144.3pt.none ${COMMON} mode 3PT ${CAGE} refinement none
thermo 1000
thermo_style custom step temp pe etotal press c_msdO[4]
run 20000
print "XPT_FINAL DONE"
