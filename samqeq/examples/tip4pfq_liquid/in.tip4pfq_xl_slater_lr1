# TIP4P-FQ liquid, 256 molecules at 1.0 g/cc, ported without refitting: exact Slater kernel with the model's own
# exponents, and lr_ewald = 1 (param header, field 6) with the pair scope `intra`, so that only intramolecular pairs
# are shielded and intermolecular pairs are bare 1/r, the structure of the original model. Rigid molecules at 298 K,
# extended-Lagrangian charges, 0.25 fs step, 3.75 ps. Converged value (eight seeds, 20 ps + 100 ps each, see README):
# 2.635 +/- 0.002 D against the published 2.637 D; a 3.75 ps run lands within about 0.02 D of it. This mode runs close
# to the polarization catastrophe and needs the thermostat.
units           metal
atom_style      full
boundary        p p p
read_data       tip4pfq_liquid.data

group           watO  type 1
group           watH  type 2
group           watM  type 3
group           fq    type 2 3

pair_style      hybrid/overlay lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 slater 2s 1 3
pair_coeff      1 1 lj/cut 0.012412 3.159
pair_coeff      1 2 lj/cut 0.0 1.0
pair_coeff      1 3 lj/cut 0.0 1.0
pair_coeff      2 2 lj/cut 0.0 1.0
pair_coeff      2 3 lj/cut 0.0 1.0
pair_coeff      3 3 lj/cut 0.0 1.0
pair_coeff      * * coul/long
pair_coeff      1 1 coul/shield/intra 3.0803
pair_coeff      2 2 coul/shield/intra 1.7007
pair_coeff      3 3 coul/shield/intra 3.0803
pair_coeff      1 2 coul/shield/intra 2.288813
pair_coeff      1 3 coul/shield/intra 3.080300
pair_coeff      2 3 coul/shield/intra 2.288813

special_bonds   lj/coul 1.0e-8 1.0e-8 1.0
kspace_style    pppm/samqeq 1.0e-5

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

fix             chg fq qeq/sam 1 0.0 10.0 1.0e-5 water4_liquid_slater_lr1.param
fix_modify      chg shield slater 2s 1 3
fix_modify      chg energy yes
fix_modify      chg xl 2.6e-6 1.0

compute         qMpa watM property/atom q
compute         qMc  watM reduce ave c_qMpa
compute         qHpa watH property/atom q
compute         qHc  watH reduce ave c_qHpa
compute         dip all dipole/samqeq
variable        mu   equal c_dip
variable        qM   equal c_qMc
variable        qH   equal c_qHc
variable        pemol equal pe/256.0
variable        T equal temp
variable        P equal press

timestep        0.00025
velocity        all create 298.0 65491 mom yes rot yes dist gaussian
fix             rig all rigid/nvt/small molecule temp 298.0 298.0 0.02

thermo          250
thermo_style    custom step temp press density pe v_pemol v_mu v_qM v_qH
thermo_modify   flush yes

compute         rdfOO all rdf 100 1 1
fix             rdfavg all ave/time 50 100 15000 c_rdfOO[*] file oo_rdf_xl_slater_lr1.dat mode vector
fix             propavg all ave/time 25 200 15000 v_mu v_qM v_qH v_T v_P v_pemol ave one file props_tail_xl_slater_lr1.dat

dump            tr all custom 1000 tip4pfq_slater_lr1.lammpstrj id type xu yu zu q
run             15000

print           "LIQUID_TAIL mu=$(f_propavg[1]:%.4f) qM=$(f_propavg[2]:%.4f) qH=$(f_propavg[3]:%.4f) T=$(f_propavg[4]:%.2f) P=$(f_propavg[5]:%.2f) PEmol=$(f_propavg[6]:%.5f)"
write_restart   tip4pfq_slater_lr1.restart
