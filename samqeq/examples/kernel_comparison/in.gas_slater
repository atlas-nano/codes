# Gas-phase sanity check for the Slater-overlap kernel port: single isolated molecule, run 0, check the
# SCF-solved dipole against Rick's gas value mu~1.85 D -- WITH NO KERNEL REFIT (unlike in.gas_sanity's
# cbrt fit or in.tip4pfq_gasref's pqeq fit, both pinned to the two rigid intramolecular distances). The
# Slater kernel is Rick's OWN J(r) (jrab.py/mdtpn.f), so his RAW zeta parameters port directly.
# Mirrors in.gas_sanity exactly (same geometry/masses/atom ordering/molecule file), swapped to
# `fix_modify chg shield slater 2s 1 3` (types 1=O, 3=M share the oxygen 2s form factor) with
# water4_gas_slater.param (gamma column = zeta, RAW 1/Angstrom -- see that file's header comment).
# lr_alpha defaults to 0 (legacy path) -> exercises FixQEqBaseSam::compute_H via the calc_Hval override
# (samQEq  item 3), NOT shielded_coulomb() (that needs lr_ewald>=2).
units           metal
atom_style      full
boundary        f f f
region          box block -20 20 -20 20 -20 20
create_box      3 box
mass            1 15.9994
mass            2 1.008
mass            3 1.0e-6
molecule        h2o water4.mol
create_atoms    0 single 0.0 0.0 0.0 mol h2o 1
group           fq type 2 3
pair_style      lj/cut/coul/cut 12.0
pair_coeff      1 1 0.0124 3.159
pair_coeff      2 2 0.0 1.0
pair_coeff      3 3 0.0 1.0
neighbor        2.0 bin
fix             chg fq qeq/sam 1 0.0 12.0 1.0e-9 water4_gas_slater.param
fix_modify      chg shield slater 2s 1 3
compute         dip  all dipole/samqeq
run             0
variable        peval equal pe
print           "${peval}" file pe.txt screen no
# dipole (Debye): mu = sqrt(sum(q_i*r_i)^2) * 4.803 (e*A -> Debye)
variable        qM equal q[4]
variable        qH1 equal q[2]
variable        qH2 equal q[3]
variable        mu equal c_dip
print           "GAS_SLATER qM=$(v_qM:%.5f) qH1=$(v_qH1:%.5f) qH2=$(v_qH2:%.5f) mu_D=$(v_mu:%.5f) pe_eV=$(v_peval:%.6f)"
write_dump      all custom charges.dump id type q modify sort id format line "%d %d %.12g"
