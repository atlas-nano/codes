# s88b acceptance case `shield_special00` (proposed tests/cases/shield_special00/in.lammps).
# Bonded rigid SPC-FQ water, coul/long + coul/shield/intra + pppm/samqeq + fix qeq/sam, with the special_bonds
# setting the guard refuses: lj 0 0 0 coul 0 0 0 under a KSPACE style. LAMMPS keeps those pairs in every
# neighbor list (neighbor.cpp:550-551 -> special_flag=2), so this deck's physics is IDENTICAL to
# `special_bonds lj 1e-300 1e-300 1e-300 coul 0 0 0` (in.golden_gen), which is legal today and produced golden/.
# Post-fix this deck must run and reproduce golden/ bit-for-bit at np1 (RTOL 1e-9 in run_tests.sh).
variable        slj index 0.0
units           metal
atom_style      full
boundary        p p p
read_data       cfg.data
mass            1 15.9994
mass            2 1.008
special_bonds   lj ${slj} ${slj} ${slj} coul 0.0 0.0 0.0
bond_style      harmonic
bond_coeff      1 22.965 1.012
angle_style     harmonic
angle_coeff     1 1.6455 113.24
group           fq type 1 2
pair_style      hybrid/overlay lj/cut 6.0 coul/long 6.0 coul/shield/intra 5.0 all
pair_coeff      1 1 lj/cut 0.01275 3.176
pair_coeff      1 2 lj/cut 0.0 1.0
pair_coeff      2 2 lj/cut 0.0 1.0
pair_coeff      * * coul/long
pair_coeff      * * coul/shield/intra 1.11
kspace_style    pppm/samqeq 1.0e-6
neighbor        1.0 bin
fix             chg fq qeq/sam 2 0.0 10.0 1.0e-5 spcfq_expt.param
fix             integ all rigid/small molecule
timestep        0.001
thermo_style    custom step temp pe ecoul elong press
thermo_modify   format float %20.12g
thermo          10
run             20
variable        peval equal pe
print           "${peval}" file pe.txt screen no
write_dump      all custom charges.dump id type q modify sort id format line "%d %d %.12g"
