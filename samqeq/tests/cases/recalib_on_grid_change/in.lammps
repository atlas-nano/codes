# Signature-gated recip_self recalibration across a second run's re-setup.
#
# setup_pre_force runs BEFORE kspace->setup() (verlet.cpp), so a recip_self recalibration there would
# run PPPM particle_map on a not-yet-finalized grid with stale end-of-run positions ("Out of range atoms -
# cannot compute PPPM" when an atom sits at the brick edge). The fix recalibrates ONLY when the PPPM grid
# signature {nx,ny,nz}_pppm + g_ewald changes (grid_changed()), evaluated in pre_force. This deck runs
# run -> reset_timestep + change timestep + swap in a new integrator fix + a fresh dump -> run, with
# lr_ewald=2 (pppm/samqeq, the recip_self path). Frozen (run 0, no integration) => deterministic.
# The grid is unchanged across the two runs, so recip_self is calibrated EXACTLY ONCE and the
# charges reproduce byte-for-byte.
units           metal
atom_style      full
boundary        p p p
region          box block -7.5 7.5 -7.5 7.5 -7.5 7.5
create_box      2 box
mass            1 15.9994
mass            2 1.008
molecule        h2o spcfq.mol
lattice         sc 5.0
create_atoms    0 box mol h2o 90210
group           fq type 1 2
set             type 1 charge -0.85
set             type 2 charge  0.425
pair_style      hybrid/overlay lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 all
pair_coeff      1 1 lj/cut 0.01275 3.176
pair_coeff      1 2 lj/cut 0.0 1.0
pair_coeff      2 2 lj/cut 0.0 1.0
pair_coeff      * * coul/long
pair_coeff      * * coul/shield/intra 1.11
kspace_style    pppm/samqeq 1.0e-6
neighbor        2.0 bin
fix             chg fq qeq/sam 1 0.0 10.0 1.0e-9 spcfq_expt.param
thermo          1
thermo_style    custom step pe
timestep        0.0010
# ---- first run: recip_self calibrated once (lr_calibrated 0 -> 1, grid signature cached) ----
run             0
# ---- the in-memory transition: dt change + integrator add + fresh dump ----
reset_timestep  0
timestep        0.0005
fix             mov fq nve
dump            d all custom 5 dump.dummy id type x y z
run             0
undump          d
unfix           mov
variable        peval equal pe
print           "${peval}" file pe.txt screen no
write_dump      all custom charges.dump id type q modify sort id format line "%d %d %.12g"
