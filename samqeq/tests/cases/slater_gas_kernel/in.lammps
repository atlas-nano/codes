# Regression case: the exact Slater-overlap shielding kernel, one gas-phase TIP4P-FQ molecule, run 0.
#
# The Slater kernel is Rick's own J(r), so the model's raw Slater exponents are used with no refit
# (water4_gas_slater.param: the fourth column is zeta in 1/Angstrom). Types 1 (O) and 3 (M) use the 2s
# form factor (`shield slater 2s 1 3`); type 2 (H) keeps the default 1s. lr_alpha and lr_ewald default to 0,
# so the charge solve assembles the Slater kernel on the short-range path. The solved dipole is 1.861 D
# (Rick: 1.85 D). Deterministic: fixed geometry, no thermostat, no random numbers.
units           metal
atom_style      full
boundary        f f f
region          box block -20 20 -20 20 -20 20
create_box      3 box
mass            1 15.9994
mass            2 1.008
mass            3 1.0e-6
molecule        h2o water4.mol
create_atoms    0 single 0.0 0.0 0.0 mol h2o 1
group           fq type 2 3
pair_style      lj/cut/coul/cut 12.0
pair_coeff      1 1 0.0124 3.159
pair_coeff      2 2 0.0 1.0
pair_coeff      3 3 0.0 1.0
neighbor        2.0 bin
fix             chg fq qeq/sam 1 0.0 12.0 1.0e-9 water4_gas_slater.param
fix_modify      chg shield slater 2s 1 3
compute         dip  all dipole/samqeq
run             0
variable        peval equal pe
print           "${peval}" file pe.txt screen no
# dipole (Debye): mu = sqrt(sum(q_i*r_i)^2) * 4.803 (e*A -> Debye)
variable        qM equal q[4]
variable        qH1 equal q[2]
variable        qH2 equal q[3]
variable        mu equal c_dip
print           "GAS_SLATER qM=$(v_qM:%.5f) qH1=$(v_qH1:%.5f) qH2=$(v_qH2:%.5f) mu_D=$(v_mu:%.5f) pe_eV=$(v_peval:%.6f)"
write_dump      all custom charges.dump id type q modify sort id format line "%d %d %.12g"
