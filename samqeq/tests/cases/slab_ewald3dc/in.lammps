# EW3DC (Yeh-Berkowitz) slab-correction regression: SPC-FQ water SLAB under
# boundary p p f + kspace_modify slab 3.0, solved with the self-contained
# long-range path (kspace_style pppm/samqeq, lr_ewald=2). This pins BOTH new
# slab code paths: (a) the analytic dipole term PPPMSamqeq::compute_vector adds
# to the charge-solve potential, and (b) the inherited PPPM::slabcorr() force/
# energy correction exercised by the 10 NVE steps (starting from zero
# velocities, so the trajectory is pure force integration -- any solve<->force
# inconsistency moves the final charges/PE). Before this feature the deck
# errored out at init: "pppm/samqeq does not support kspace_modify slab".
units           metal
atom_style      full
boundary        p p f
lattice         sc 3.1
region          box block 0 4 0 4 0 4
create_box      2 box
# atoms only in the central z band -> vacuum gap at both f faces (slab geometry)
region          slabr block 0 4 0 4 0.6 3.4
mass            1 15.9994
mass            2 1.008
molecule        h2o spcfq.mol
create_atoms    0 region slabr mol h2o 12345
group           fq type 1 2
set             type 1 charge -0.85
set             type 2 charge  0.425
pair_style      hybrid/overlay lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 all
pair_coeff      1 1 lj/cut 0.01275 3.176
pair_coeff      1 2 lj/cut 0.0 1.0
pair_coeff      2 2 lj/cut 0.0 1.0
pair_coeff      * * coul/long
pair_coeff      * * coul/shield/intra 1.11
kspace_style    pppm/samqeq 1.0e-6
kspace_modify   slab 3.0
neighbor        2.0 bin
fix             chg fq qeq/sam 1 0.0 10.0 1.0e-5 spcfq_expt.param
timestep        0.0005
fix             mdnve all nve
thermo          5
run             10
variable        peval equal pe
print           "${peval}" file pe.txt screen no
write_dump      all custom charges.dump id type q modify sort id format line "%d %d %.12g"
