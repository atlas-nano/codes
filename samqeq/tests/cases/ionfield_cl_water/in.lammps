# ionfield_cl_water: ONE SPC-FQ water in the solve group + ONE FIXED Cl- (type 3, q=-1) OUTSIDE the group.
# Exercises the `ionfield` pass (fix_qeq_sam_lr.cpp add_fixed_charge_field(false)) with a REAL non-group
# source: real-space shielded field + reciprocal compute_vector(invert_source) + the RHS fold. It is the only
# case with a charged atom outside its solve group. Control (not a golden): `fix_modify chg ionfield off`
# gives the ion-blind lone-water charges (O -0.668091), within ~4e-5 of spcfq_gas_ewald -- not exact, because PPPM's
# automatic g_ewald changes with the extra charge. The pass moves O by 0.075 e and polarizes H 0.506/0.237.
units           metal
atom_style      full
boundary        p p p
region          box block -14 14 -14 14 -14 14
create_box      3 box
mass            1 15.9994
mass            2 1.008
mass            3 35.453
molecule        h2o spcfq.mol
create_atoms    0 single 0.0 0.0 0.0 mol h2o 1
create_atoms    3 single 0.0 3.2 0.0            # Cl- on the H side (H at y=0.577), r(H-Cl) ~ 2.75 A
group           fq type 1 2                     # water only: the Cl- is a FIXED non-group source
group           ion type 3
set             type 1 charge -0.85
set             type 2 charge  0.425
set             type 3 charge -1.0
pair_style      hybrid/overlay lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 all
pair_coeff      1 1 lj/cut 0.01275 3.176
pair_coeff      1 2 lj/cut 0.0 1.0
pair_coeff      2 2 lj/cut 0.0 1.0
pair_coeff      1 3 lj/cut 0.0 1.0
pair_coeff      2 3 lj/cut 0.0 1.0
pair_coeff      3 3 lj/cut 0.0 1.0
pair_coeff      * * coul/long
pair_coeff      * * coul/shield/intra 1.11
kspace_style    pppm/samqeq 1.0e-6
neighbor        2.0 bin
compute         dip fq dipole/samqeq
fix             chg fq qeq/sam 1 0.0 10.0 1.0e-9 spcfq_cl.param
# (ionfield is ON by default; the setup log must carry "1 fixed charged atom(s) lie outside the charge-solve group")
thermo          1
thermo_style    custom step pe c_dip
run             0
variable        dipval equal c_dip
print           "GASDIPOLE ${dipval}"
variable        peval equal pe
print           "${peval}" file pe.txt screen no
write_dump      all custom charges.dump id type q modify sort id format line "%d %d %.12g"
