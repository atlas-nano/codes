# Bit-correctness: SPC-FQ single molecule, short-range (no kspace) qeq/sam solve.
# Exercises the core charge solver / gate / per-molecule-neutral projection with
# no FFT, so it is the tightest determinism baseline.
units           metal
atom_style      full
boundary        f f f
region          box block -20 20 -20 20 -20 20
create_box      2 box
mass            1 15.9994
mass            2 1.008
molecule        h2o spcfq.mol
create_atoms    0 single 0.0 0.0 0.0 mol h2o 1
group           fq type 1 2
pair_style      lj/cut/coul/cut 12.0
pair_coeff      1 1 0.01275 3.176
pair_coeff      2 2 0.0 1.0
neighbor        2.0 bin
fix             chg fq qeq/sam 1 0.0 12.0 1.0e-9 spcfq.param
run             0
variable        peval equal pe
print           "${peval}" file pe.txt screen no
write_dump      all custom charges.dump id type q modify sort id format line "%d %d %.12g"
