# A5 regression: molecule-OPTIONAL solve. Bare atom_style charge (NO molecule IDs)
# periodic binary solid on the full long-range path (pppm/samqeq, lr_ewald=2).
# Without molecule IDs build_molinv/project_neutral fall back to ONE global fragment,
# i.e. the projector enforces GLOBAL charge neutrality — the standard QEq constraint
# for a solid. Two chi's (type 1 soft donor slab / type 2 acceptor slab) force a real
# inter-slab charge transfer through the global constraint + PPPM reciprocal, so this
# pins the whole molecule-free lr solve. Pre-A5 this deck was a hard error.
units           metal
atom_style      charge
boundary        p p p
lattice         sc 2.2
region          box block 0 5 0 5 0 5
create_box      2 box
create_atoms    1 box
region          lower block 0 5 0 5 0 2.49
set             region lower type 2
mass            * 12.0
set             group all charge 0.0
pair_style      hybrid/overlay lj/cut 5.0 coul/long 5.0
pair_coeff      * * lj/cut 0.01 2.2
pair_coeff      * * coul/long
kspace_style    pppm/samqeq 1.0e-6
kspace_modify   gewald 0.35
neighbor        1.0 bin
fix             chg all qeq/sam 1 0.0 5.0 1.0e-8 solid.param
run             0
variable        peval equal pe
print           "${peval}" file pe.txt screen no
write_dump      all custom charges.dump id type q modify sort id format line "%d %d %.12g"
