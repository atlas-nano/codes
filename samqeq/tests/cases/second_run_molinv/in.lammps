# build_molinv on a SECOND run's setup_pre_force.
#
# Every `run` triggers setup_pre_force -> deallocate_storage (frees+nulls molinv/molsum, resets
# nmol_) -> pre_force -> qeq_solve -> build_molinv, which must re-create the arrays. This case does
# TWO runs with a mid-deck reset_timestep + a freshly-added dump between them. lr_ewald=2
# (pppm/samqeq) is the path that owns qeq_solve/build_molinv. A small multi-molecule box makes
# build_molinv do real per-molecule projector work (nmol > 2). Frozen (no time integration) =>
# fully deterministic. Both runs must complete and the charges reproduce byte-for-byte.
units           metal
atom_style      full
boundary        p p p
region          box block -7.5 7.5 -7.5 7.5 -7.5 7.5
create_box      2 box
mass            1 15.9994
mass            2 1.008
molecule        h2o spcfq.mol
lattice         sc 5.0
create_atoms    0 box mol h2o 90210
group           fq type 1 2
set             type 1 charge -0.85
set             type 2 charge  0.425
pair_style      hybrid/overlay lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 all
pair_coeff      1 1 lj/cut 0.01275 3.176
pair_coeff      1 2 lj/cut 0.0 1.0
pair_coeff      2 2 lj/cut 0.0 1.0
pair_coeff      * * coul/long
pair_coeff      * * coul/shield/intra 1.11
kspace_style    pppm/samqeq 1.0e-6
neighbor        2.0 bin
fix             chg fq qeq/sam 1 0.0 10.0 1.0e-9 spcfq_expt.param
thermo          1
thermo_style    custom step pe
# ---- first run: build_molinv created (nmol_ 0 -> nmol) ----
run             0
# ---- mid-deck change + SECOND run: setup_pre_force fires again ----
reset_timestep  0
dump            d all custom 5 dump.dummy id type x y z
run             0
undump          d
variable        peval equal pe
print           "${peval}" file pe.txt screen no
write_dump      all custom charges.dump id type q modify sort id format line "%d %d %.12g"
